# Your store's myshopify domain
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Option A: an Admin API access token (shpat_...) from a custom app
SHOPIFY_ADMIN_TOKEN=

# Option B: a Dev Dashboard app installed on your store (client credentials grant)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: PIN staff must enter on the phone (recommended — orders contain customer data)
APP_PIN=

# Optional
# SHOPIFY_STORE_HANDLE=your-store    # the part in admin.shopify.com/store/<handle>, if different
# SHOPIFY_API_VERSION=2026-07
# PORT=3000
